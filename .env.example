# Container images
WEB_IMAGE=ghcr.io/bailangguihun/auralink-web:latest
CORE_API_IMAGE=ghcr.io/bailangguihun/auralink-core-api:latest
AI_SERVICE_IMAGE=ghcr.io/bailangguihun/auralink-ai-service:latest

# Public port
HTTP_PORT=80

# Replace this value in the real .env file
JWT_SECRET=replace_with_a_long_random_secret

# Public painting image URL
IMAGE_BASE_URL=https://api.auralinks.top/api/paintings/images

# Persistent host directories
DATABASE_DIR=/data/auralink/database
UPLOAD_DIR=/data/auralink/uploads
AUDIO_DIR=/data/auralink/audio
PICTURE_DIR=/data/auralink/picture
MODEL_DIR=/data/auralink/models

# Copy paintings.csv from auralink-core-api to this path
PAINTINGS_CSV_HOST_PATH=/data/auralink/metadata/paintings.csv

# Hugging Face endpoint
HF_ENDPOINT=https://hf-mirror.com

# VMM service
VMM_MODEL_PATH=/data/auralink/models/vmm/musicgen-small
VMM_CHECKPOINT_PATH=/data/auralink/models/vmm/final_model.pth
VMM_DEVICE=cuda

# Vision service
QWEN_MODEL_PATH=/data/auralink/models/qwen_vl/checkpoint-400-merged-new
